# Valores para o servidor PHP; carregue-os via ambiente, não exponha este arquivo na web.
# EXEMPLO: export ORQUESTRA_UPLOAD_TOKEN="token-aleatorio-forte"
ORQUESTRA_UPLOAD_TOKEN=ALTERE_PARA_TOKEN_SEGURO
ORQUESTRA_DATA_DIR=/caminho/privado/orquestra-documents
ORQUESTRA_REQUIRE_IMAGE_PROFILE=1
ORQUESTRA_IMAGE_PROFILES_JSON={"banner-site":{"width":1200,"height":630,"mime":"image/webp"},"avatar":{"width":400,"height":400,"mime":"image/webp"}}
