{
  "schemaVersion": "1.0",
  "name": "documentos-contabilidade-publica",
  "version": "1.0.0",
  "components": [
    "file-uploader",
    "file-viewer",
    "document-search"
  ],
  "upload": {
    "extensions": {
      "pdf": 20971520,
      "xml": 5242880,
      "xlsx": 10485760
    },
    "maxFiles": 30,
    "maxTotalBytes": 104857600
  },
  "processing": {
    "ocr": true,
    "ai": false,
    "classification": true,
    "reviewExceptions": true
  },
  "metadata": {
    "fields": [
      {
        "name": "exercicio",
        "type": "number",
        "label": "Exercício"
      },
      {
        "name": "empenho",
        "type": "text",
        "label": "Empenho"
      }
    ]
  }
}
